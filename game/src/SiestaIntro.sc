(version 2)
(include "sci.sh")
(include "game.sh")
(exports 0 siestaIntro)
(use "Main")
(use "Game")
(use "Sound")
(use "System")
(script 120)
(local started = 0 frame = 0 finished = 0)

// A startup presentation, outside the three playable rooms. Raw input handlers
// make every key and mouse button skip before inventory or toolbar processing.
(instance public siestaIntro of Room
    (properties picture 120 style 100)
    (method (init)
        (super:init())
        (= started GetTime())
        (= frame 0)
        (= finished FALSE)
        HideStatus()
        (send gMusic1:stop())
        (send gIconBar:hide() disable())
        (send gUser:canControl(FALSE) canInput(TRUE))
        (send gOldMH:addToFront(self))
        (send gOldKH:addToFront(self))
        (send gGame:setCursor(999 FALSE))
        (siestaFanfare:play())
    )
    (method (handleEvent event)
        (if (& (send event:type) (| evKEYBOARD evMOUSEBUTTON))
            (= finished TRUE)
            (send event:claimed(TRUE))
            return TRUE
        )
        return FALSE
    )
    (method (doit)
        (var elapsed, nextFrame)
        (= elapsed (- GetTime() started))
        (if (finished or (>= elapsed 480))
            (send gGame:newRoom(110))
            return
        )
        (= nextFrame 0)
        (if (>= elapsed 180) (= nextFrame 1))
        (if (>= elapsed 198) (= nextFrame 2))
        (if (>= elapsed 219) (= nextFrame 3))
        (if (>= elapsed 240) (= nextFrame 4))
        (if (>= elapsed 270) (= nextFrame 5))
        (if (<> frame nextFrame)
            (= frame nextFrame)
            (self:drawPic((+ 120 frame) 100))
            // DrawPic becomes visible during the following Animate pass.
            Animate(0)
            (if (== frame 5)
                Display("ADVENTURES AFTER LUNCH." dsCOORD 99 162 dsFONT gFont dsCOLOR 6)
                Graph(grUPDATE_BOX 160 0 176 320 VISUAL)
            )
        )
    )
    (method (dispose)
        (siestaFanfare:stop() dispose())
        (send gOldMH:delete(self))
        (send gOldKH:delete(self))
        (send gIconBar:enable() disable(ICONINDEX_CURITEM))
        (send gGame:setCursor(980 TRUE))
        (send gMusic1:play())
        (super:dispose())
    )
)
(instance siestaFanfare of Sound
    (properties number 306 priority 15 loop 1)
)
