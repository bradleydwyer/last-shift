(version 2)
(include "sci.sh")
(include "game.sh")
(exports 0 rm110)
(use "Main")
(use "Game")
(use "Actor")
(use "Cycle")
(use "Scaler")
(use "Feature")
(use "System")
(use "Polygon")
(use "StationActions")
(script 110)
(local floor[19] = (1 PContainedAccess 8 319 189 319 146 276 146 276 152 126 152 96 177 0 177 0 189))
(instance public rm110 of Room
    (properties picture 110 style (| dpANIMATION_BLACKOUT dpOPEN_FADEPALETTE) horizon 100)
    (method (init)
        AddPolygonsToRoom(@floor)
        (super:init())
        SetUpEgo(0 2)
        // Perspective follows the actor foot position, including interaction views.
        (send gEgo:posn(160 166) init() setCycle(Walk) setScale(Scaler 125 90 189 140))
        // Keep movement increments stable; gait scales independently.
        (send gEgo:scaleSignal((| (send gEgo:scaleSignal) ssNotStepScale)))
        (= gWalkHandler self)
        (roomHotspots:init())
        (doorForeground:init())
        (chestBackdrop:init())
        (toolboxLid:init())
        (if (send gEgo:has(INV_WRENCH)) (toolboxLid:cel(2)))
        (send gGame:handsOn())
        StationEnter(110)
        (if (not Btest(F_INTRO))
            Bset(F_INTRO)
            (self:setScript(intro))
        )
    )
    (method (dispose param1)
        (= gWalkHandler 0)
        (super:dispose(rest param1))
    )
    (method (handleEvent event)
        (var px, py, verb, target)
        (if (send event:claimed) return 1)
        (if (& (send event:type) evVERB)
            (= px (send event:x))
            (= py (send event:y))
            (= verb (send event:message))
            (= target 0)
            (if ((>= px 4) and (<= px 58) and (>= py 68) and (<= py 119)) (= target 1))
            (if ((>= px 137) and (<= px 188) and (>= py 99) and (<= py 121)) (= target 2))
            (if ((>= px 277) and (<= px 319) and (>= py 51) and (<= py 185)) (= target 3))
            (if ((>= px 54) and (<= px 222) and (>= py 15) and (<= py 84)) (= target 4))
            (if ((<> verb V_WALK) or ((== target 3)))
                StationAction(110 target verb toolboxLid)
                (send event:claimed(TRUE))
                return 1
            )
            (if (< py 152) (send event:y(152)))
            (if (> py 185) (send event:y(185)))
            (if (< px 12) (send event:x(12)))
            (if (> px 308) (send event:x(308)))
        )
        return 0
    )
)
(instance intro of Script
    (properties)
    (method (changeState newState)
        (switch (= state newState)
            (case 0 (= cycles 2))
            (case 1 StationIntro() (self:dispose()))
        )
    )
)

// Route background interactions ahead of the actor, so the player cannot occlude a hotspot.
(instance roomHotspots of Feature
    (properties x 160 y 190)
    (method (onMe event)
        return 1
    )
    (method (handleEvent event)
        return (send gRoom:handleEvent(event))
    )
)

// Original wall and jamb pixels draw in front of actors walking into a doorway.
(instance doorForeground of Prop
    (properties view 904 loop 0 cel 0 x 160 y 189 priority 15 signal $4010)
    (method (onMe event) return 0)
)

// Three matched cels replace the painted lid during the pickup sequence.
(instance toolboxLid of Prop
    (properties view 907 loop 0 cel 0 x 162 y 125 priority 1 signal $4010)
    (method (onMe event) return 0)
)

(instance chestBackdrop of Prop
    (properties view 910 loop 0 cel 0 x 163 y 122 priority 1 signal $4010)
    (method (onMe event) return 0)
)
