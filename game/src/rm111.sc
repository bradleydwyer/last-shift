(version 2)
(include "sci.sh")
(include "game.sh")
(exports 0 rm111)
(use "Main")
(use "Game")
(use "Actor")
(use "Cycle")
(use "Scaler")
(use "Feature")
(use "System")
(use "Polygon")
(use "StationActions")
(script 111)
(local floor[23] = (1 PContainedAccess 10 319 189 319 146 299 146 299 175 240 169 226 148 44 148 44 146 0 146 0 189) benchGone = 0 reactorOn = 0)
(instance public rm111 of Room
    (properties picture 111 style (| dpANIMATION_BLACKOUT dpOPEN_FADEPALETTE) horizon 100)
    (method (init)
        AddPolygonsToRoom(@floor)
        (super:init())
        SetUpEgo(0 2)
        // Perspective follows the actor foot position, including interaction views.
        (send gEgo:posn(160 166) init() setCycle(Walk) setScale(Scaler 125 90 189 140))
        // Keep movement increments stable; gait scales independently.
        (send gEgo:scaleSignal((| (send gEgo:scaleSignal) ssNotStepScale)))
        (= gWalkHandler self)
        (roomHotspots:init())
        (doorForeground:init())
        (= benchGone 0)
        (= reactorOn 0)
        (send gGame:handsOn())
        StationEnter(111)
        (if (not Btest(F_INTRO))
            Bset(F_INTRO)
            (self:setScript(intro))
        )
    )
    (method (doit)
        (super:doit())
        (if ((Btest(F_CELL_TAKEN)) and (not benchGone))
            (= benchGone 1)
            (emptyBench:init())
        )
        (if ((Btest(F_POWER)) and (not reactorOn))
            (= reactorOn 1)
            (poweredGenerator:init() cycleSpeed(10) setCycle(Forward))
        )
    )
    (method (dispose param1)
        (= gWalkHandler 0)
        (super:dispose(rest param1))
    )
    (method (handleEvent event)
        (var px, py, verb, target)
        (if (send event:claimed) return 1)
        (if (& (send event:type) evVERB)
            (= px (send event:x))
            (= py (send event:y))
            (= verb (send event:message))
            (= target 0)
            (if ((>= px 0) and (<= px 35) and (>= py 55) and (<= py 185)) (= target 1))
            (if ((>= px 82) and (<= px 209) and (>= py 32) and (<= py 126)) (= target 2))
            // Include the cell and bench surface below it, with a small margin.
            (if ((>= px 250) and (<= px 298) and (>= py 90) and (<= py 130)) (= target 3))
            // The narrow visible opening and its threshold both lead to the pod bay.
            // Include the lower edge so clicking the walking destination triggers exit.
            (if ((>= px 299) and (<= px 319) and (>= py 45) and (<= py 185)) (= target 4))
            (if ((<> verb V_WALK) or ((== target 1) or (== target 4)))
                StationAction(111 target verb)
                (send event:claimed(TRUE))
                return 1
            )
            (if (< py 148) (send event:y(148)))
            (if (> py 185) (send event:y(185)))
            (if (< px 12) (send event:x(12)))
            (if (> px 308) (send event:x(308)))
        )
        return 0
    )
)
(instance intro of Script
    (properties)
    (method (changeState newState)
        (switch (= state newState)
            (case 0 (= cycles 2))
            (case 1 StationIntro() (self:dispose()))
        )
    )
)

// Route background interactions ahead of the actor, so the player cannot occlude a hotspot.
(instance roomHotspots of Feature
    (properties x 160 y 190)
    (method (onMe event)
        return 1
    )
    (method (handleEvent event)
        return (send gRoom:handleEvent(event))
    )
)

// Original wall and jamb pixels draw in front of actors walking into a doorway.
(instance doorForeground of Prop
    (properties view 905 loop 0 cel 0 x 160 y 189 priority 15 signal $4010)
    (method (onMe event) return 0)
)

(instance emptyBench of Prop
    (properties view 909 loop 0 cel 0 x 276 y 118 priority 1 signal $4010)
    (method (onMe event) return 0)
)

// A stationary socket glows and pulses once auxiliary power is restored.
(instance poweredGenerator of Prop
    (properties view 911 loop 0 cel 0 x 160 y 96 priority 1 signal $4010)
    (method (onMe event) return 0)
)
