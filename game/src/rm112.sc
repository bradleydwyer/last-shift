(version 2)
(include "sci.sh")
(include "game.sh")
(exports 0 rm112)
(use "Main")
(use "Game")
(use "Actor")
(use "Cycle")
(use "Scaler")
(use "Feature")
(use "System")
(use "Polygon")
(use "StationActions")
(script 112)
(local floor[19] = (1 PContainedAccess 8 319 189 319 171 210 171 174 158 45 158 45 146 0 146 0 189))
(instance public rm112 of Room
    (properties picture 112 style (| dpANIMATION_BLACKOUT dpOPEN_FADEPALETTE) horizon 100)
    (method (init)
        AddPolygonsToRoom(@floor)
        (super:init())
        SetUpEgo(0 2)
        // Perspective follows the actor foot position, including interaction views.
        (send gEgo:posn(160 166) init() setCycle(Walk) setScale(Scaler 125 90 189 140))
        // Keep movement increments stable; gait scales independently.
        (send gEgo:scaleSignal((| (send gEgo:scaleSignal) ssNotStepScale)))
        (= gWalkHandler self)
        (roomHotspots:init())
        (doorForeground:init())
        (send gGame:handsOn())
        StationEnter(112)
        (if (not Btest(F_INTRO))
            Bset(F_INTRO)
            (self:setScript(intro))
        )
    )
    (method (dispose param1)
        (= gWalkHandler 0)
        (super:dispose(rest param1))
    )
    (method (handleEvent event)
        (var px, py, verb, target)
        (if (send event:claimed) return 1)
        (if (& (send event:type) evVERB)
            (= px (send event:x))
            (= py (send event:y))
            (= verb (send event:message))
            (= target 0)
            (if ((>= px 0) and (<= px 38) and (>= py 54) and (<= py 185)) (= target 1))
            (if ((>= px 56) and (<= px 100) and (>= py 85) and (<= py 136)) (= target 2))
            (if ((>= px 174) and (<= px 319) and (>= py 41) and (<= py 140)) (= target 3))
            (if ((>= px 47) and (<= px 232) and (>= py 11) and (<= py 83)) (= target 4))
            (if ((<> verb V_WALK) or ((== target 1)))
                StationAction(112 target verb)
                (send event:claimed(TRUE))
                return 1
            )
            (if (< py 158) (send event:y(158)))
            (if (> py 185) (send event:y(185)))
            (if (< px 12) (send event:x(12)))
            (if (> px 308) (send event:x(308)))
        )
        return 0
    )
)
(instance intro of Script
    (properties)
    (method (changeState newState)
        (switch (= state newState)
            (case 0 (= cycles 2))
            (case 1 StationIntro() (self:dispose()))
        )
    )
)

// Route background interactions ahead of the actor, so the player cannot occlude a hotspot.
(instance roomHotspots of Feature
    (properties x 160 y 190)
    (method (onMe event)
        return 1
    )
    (method (handleEvent event)
        return (send gRoom:handleEvent(event))
    )
)

// Original wall and jamb pixels draw in front of actors walking into a doorway.
(instance doorForeground of Prop
    (properties view 906 loop 0 cel 0 x 160 y 189 priority 15 signal $4010)
    (method (onMe event) return 0)
)
